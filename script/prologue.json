[
{"id": "C1621D", "jp": "至高神は告げた。{end}", "en": ""},
{"id": "C1622A", "jp": "「我が力を分けた乙女達よ{end}", "en": ""},
{"id": "C1623D", "jp": "既に地は静まり、生き物はこえた。{end}", "en": ""},
{"id": "C16253", "jp": "大いなる法を定め{end}", "en": ""},
{"id": "C1625F", "jp": "我が妻を選ぶ時が来たようだ。{end}", "en": ""},
{"id": "C16273", "jp": "汝らに問おう。{end}", "en": ""},
{"id": "C1627D", "jp": "妻となる用意のととのいし者はいるか」{end}", "en": ""},
{"id": "C16294", "jp": "七人の女神たちは顔を見合わせた。{end}", "en": ""},
{"id": "C162AC", "jp": "しばしの間、期待と恥じらいと{end}", "en": ""},
{"id": "C162BF", "jp": "恐れの入り交じった感情が{end}", "en": ""},
{"id": "C162D1", "jp": "その場を支配した。{end}", "en": ""},
{"id": "C162DE", "jp": "やがて古の女神がみなの意見を表した。{end}", "en": ""},
{"id": "C162F7", "jp": "「それは私どもにとり、{end}", "en": ""},
{"id": "C16304", "jp": "大変恐れ多い事でございます」{end}", "en": ""},
{"id": "C16318", "jp": "至高神は大いに驚き、怪しんだ。{end}", "en": ""},
{"id": "C1632E", "jp": "「なんということ!{end}", "en": ""},
{"id": "C16338", "jp": "だが、法を定めねば{end}", "en": ""},
{"id": "C16344", "jp": "地は定まらぬ。星も定まらぬ。{end}", "en": ""},
{"id": "C16357", "jp": "何より命が定まらぬ。{end}", "en": ""},
{"id": "C16365", "jp": "今一度問う。{end}", "en": ""},
{"id": "C16370", "jp": "我が妻となる者はおらぬか!」{end}", "en": ""},
{"id": "C16382", "jp": "そして再びの静粛。{end}", "en": ""},
{"id": "C1638F", "jp": "だがそこで、一人の女神がすすみ出た。{end}", "en": ""},
{"id": "C163A7", "jp": "闇の女神であった。{end}", "en": ""},
{"id": "C163B4", "jp": "黒き乙女は告げた。{end}", "en": ""},
{"id": "C163C2", "jp": "「もしお許しあらば{end}", "en": ""},
{"id": "C163CD", "jp": "私が妻となりましょう。{end}", "en": ""},
{"id": "C163DB", "jp": "そしておのが欲するままに歩む正しさと{end}", "en": ""},
{"id": "C163F1", "jp": "闇の中にて訪れる、{end}", "en": ""},
{"id": "C163FE", "jp": "静かなる安らぎを与えましょうぞ。{end}", "en": ""},
{"id": "C16412", "jp": "ぜひとも私めにその栄誉を…」{end}", "en": ""},
{"id": "C16424", "jp": "だが、闇の女神が言い終わらぬうちに、{end}", "en": ""},
{"id": "C1643C", "jp": "今一人の女神が進み出た。{end}", "en": ""},
{"id": "C16450", "jp": "光の女神であった。{end}", "en": ""},
{"id": "C1645D", "jp": "白き乙女は告げた。{end}", "en": ""},
{"id": "C1646B", "jp": "「お待ちください。その栄誉、私めに{end}", "en": ""},
{"id": "C16481", "jp": "賜りたくぞんじます。{end}", "en": ""},
{"id": "C1648D", "jp": "私は全てを照らす真実の光を{end}", "en": ""},
{"id": "C164A1", "jp": "そして魂の暖かさを{end}", "en": ""},
{"id": "C164AD", "jp": "あなたの心に捧げましょう」{end}", "en": ""},
{"id": "C164BD", "jp": "至高神は慌てて答えた。{end}", "en": ""},
{"id": "C164CE", "jp": "「待て待て、{end}", "en": ""},
{"id": "C164D7", "jp": "2人もめとるわけにはいかぬ」{end}", "en": ""},
{"id": "C164E7", "jp": "「ならば私をお選び下さいませ。{end}", "en": ""},
{"id": "C164FA", "jp": "我が闇は光より勝れる者」{end}", "en": ""},
{"id": "C1650C", "jp": "「いやいや。私を。{end}", "en": ""},
{"id": "C16517", "jp": "我が光こそ…」{end}", "en": ""},
{"id": "C16521", "jp": "至高神はしばらくの間考え、{end}", "en": ""},
{"id": "C16534", "jp": "そしてついに結綸を下した。{end}", "en": ""},
{"id": "C16545", "jp": "「ならば闘って決めるがよい。{end}", "en": ""},
{"id": "C16556", "jp": "どちらが真の法にふさわしきかを!」{end}", "en": ""},
{"id": "C1656A", "jp": "かくして闘いは始まった…。{end}", "en": ""},
