{"id": "C17625", "jp": " {end}", "en": ""},
{"id": "C17627", "jp": " {end}", "en": ""},
{"id": "C17629", "jp": "この戦争は…一体…?{end}", "en": "This war... what on earth...?{end}"},
{"id": "C17638", "jp": "神のゲームなのか?{end}", "en": "Is it a game of the gods?{end}"},
{"id": "C17643", "jp": " {end}", "en": ""},
