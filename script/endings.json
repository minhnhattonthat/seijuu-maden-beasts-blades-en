{"id": "C17586", "jp": "「人間は光の法で治める事にしよう」{end}", "en": "\"Humanity shall obey the Law of Light.\"{end}"},
{"id": "C1759E", "jp": " {end}", "en": ""},
{"id": "C175A0", "jp": " {end}", "en": ""},
{"id": "C175A2", "jp": " {end}", "en": ""},
{"id": "C175A4", "jp": "頭に直接響いてくるリンとした声。{end}", "en": "A clear voice rings right in my head.{end}"},
{"id": "C175BA", "jp": "至高神。{end}", "en": "The Supreme God.{end}"},
{"id": "C175C2", "jp": "「ありがたき幸せでございます」{end}", "en": "\"I am most humbly grateful.\"{end}"},
{"id": "C175D3", "jp": "「…次は、次はこんなこと…{end}", "en": "\"...Next time... next time, this...{end}"},
{"id": "C175E3", "jp": " 次は勝ってみせる」{end}", "en": " Next time, I will win.\"{end}"},
{"id": "C175F0", "jp": "「ほほほ!私もあなたには{end}", "en": "\"Ohoho! Nor do I expect to lose{end}"},
{"id": "C175FE", "jp": " 負ける気がしませんわ!」{end}", "en": " to you, my dear!\"{end}"},
{"id": "C1760E", "jp": "二人の女神が会話をしている。{end}", "en": "The two Goddesses are talking.{end}"},
