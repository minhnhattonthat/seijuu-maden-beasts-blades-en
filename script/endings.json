{"id": "C17359", "jp": " {end}", "en": ""},
{"id": "C1735B", "jp": "獣の口が静かにゆっくりと開く…{end}", "en": "The beast's jaws slowly, quietly open...{end}"},
{"id": "C1736F", "jp": " {end}", "en": ""},
{"id": "C17371", "jp": " {end}", "en": ""},
{"id": "C17373", "jp": " {end}", "en": ""},
